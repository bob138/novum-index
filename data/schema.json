{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bob138.github.io/frontier-index/data/schema.json",
  "title": "The Frontier Index Breakthroughs Dataset",
  "type": "object",
  "required": ["meta", "breakthroughs"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "lastUpdated", "defaultWeights"],
      "properties": {
        "version": { "type": "string" },
        "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "defaultWeights": {
          "type": "object",
          "required": ["foundational", "ripple", "verification", "velocity"],
          "properties": {
            "foundational": { "type": "number", "minimum": 0, "maximum": 100 },
            "ripple": { "type": "number", "minimum": 0, "maximum": 100 },
            "verification": { "type": "number", "minimum": 0, "maximum": 100 },
            "velocity": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "breakthroughs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "shortTitle",
          "date",
          "discipline",
          "subfields",
          "aiRole",
          "aiSystem",
          "verificationStatus",
          "whyItMatters",
          "summary",
          "technicalHighlights",
          "caveats",
          "contributors",
          "institutions",
          "scores",
          "scoreRationale",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 5 },
          "shortTitle": { "type": "string", "minLength": 3, "maxLength": 48 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "discipline": {
            "type": "string",
            "enum": [
              "Mathematics",
              "Computer Science & AI",
              "Physics & Quantum",
              "Biology & Medicine",
              "Chemistry & Materials"
            ]
          },
          "subfields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "aiRole": {
            "type": "string",
            "enum": ["Autonomous AI", "AI-Assisted"]
          },
          "aiSystem": { "type": "string", "minLength": 2 },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "Formally Verified",
              "Peer-Reviewed",
              "Preprint / Active Review",
              "Contested / Partial"
            ]
          },
          "yearsUnsolved": { "type": ["integer", "null"], "minimum": 0 },
          "aiTimeToSolve": { "type": ["string", "null"], "minLength": 2, "maxLength": 48 },
          "isAnchor": { "type": "boolean" },
          "whyItMatters": { "type": "string", "minLength": 20, "maxLength": 240 },
          "summary": { "type": "string", "minLength": 40 },
          "technicalHighlights": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "caveats": { "type": "string" },
          "contributors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "institutions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "scores": {
            "type": "object",
            "required": ["foundational", "ripple", "verification", "velocity"],
            "properties": {
              "foundational": { "type": "number", "minimum": 0, "maximum": 100 },
              "ripple": { "type": "number", "minimum": 0, "maximum": 100 },
              "verification": { "type": "number", "minimum": 0, "maximum": 100 },
              "velocity": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "scoreRationale": {
            "type": "object",
            "required": ["foundational", "ripple", "verification", "velocity"],
            "properties": {
              "foundational": { "type": "string" },
              "ripple": { "type": "string" },
              "verification": { "type": "string" },
              "velocity": { "type": "string" }
            }
          },
          "enables": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "url", "type"],
              "properties": {
                "label": { "type": "string" },
                "url": { "type": "string", "pattern": "^https?://" },
                "type": {
                  "type": "string",
                  "enum": ["paper", "formal-verification", "announcement", "explainer", "code", "social-post"]
                }
              }
            }
          }
        }
      }
    }
  }
}
