{
  "name": "novum-index",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Novum Index — An open-source interactive tracker, visualization suite, and impact ranking of AI-assisted and AI-led breakthroughs across Mathematics, Computer Science, and the Sciences.",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && vite",
    "build": "node scripts/build-data.mjs && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs"
  },
  "keywords": [
    "science",
    "mathematics",
    "computer-science",
    "breakthroughs",
    "ai-for-science",
    "data-visualization",
    "open-source"
  ],
  "license": "MIT",
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
